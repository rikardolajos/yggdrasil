#version 460

// gfxCmdDispatch() rounds the particle count up to whole workgroups of this
// size, so the invocations past the end are skipped below
layout(local_size_x = 256) in;

struct Particle {
    vec4 position; // xyz = position, w unused
    vec4 velocity; // xyz = velocity, w unused
};

// Declared without an instance name, so it is attached by its block name
layout(set = 0, binding = 0, std430) buffer Particles {
    Particle particles[];
};

layout(push_constant) uniform PushConstants {
    vec3 attractor;
    float strength;
    float delta;
    float damping;
    uint particleCount;
} pc;

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= pc.particleCount) {
        return;
    }

    Particle particle = particles[index];

    // Pull towards the attractor with an inverse square law, softened so that
    // the force stays finite at the center
    vec3 toAttractor = pc.attractor - particle.position.xyz;
    float distanceSquared = dot(toAttractor, toAttractor) + 0.5;
    vec3 acceleration = pc.strength * toAttractor * inversesqrt(distanceSquared) / distanceSquared;

    // Damping as a rate rather than a per-frame factor, so the motion does not
    // depend on the framerate
    float dampingFactor = exp(-pc.damping * pc.delta);

    particle.velocity.xyz = (particle.velocity.xyz + acceleration * pc.delta) * dampingFactor;
    particle.position.xyz += particle.velocity.xyz * pc.delta;

    particles[index] = particle;
}
